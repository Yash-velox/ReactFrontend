# Backend public URL (Cloudflare tunnel) — no trailing slash
VITE_API_BASE_URL=http://127.0.0.1:8080
# In cloudflare tunnel mode:
# VITE_API_BASE_URL=https://your-backend.trycloudflare.com

# Shopify Partner app API key (same as client_id in shopify.app.toml)
VITE_SHOPIFY_API_KEY=

# App handle from Partner Dashboard / shopify.app.toml
VITE_SHOPIFY_APP_HANDLE=image-enhancement

# POC runtime mode:
# true  = frontend-only temporary simulation (zero backend API calls)
# false = real backend + OpenAI flow
VITE_POC_TEMP_MODE=false

# When using ngrok for this frontend, set for reliable HMR through the tunnel:
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_PROTOCOL=wss
